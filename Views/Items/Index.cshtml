@model List<EquipmentManagement.Models.Item>

<h1>備品一覧</h1>

<p>
    <a asp-action="Create">新規登録</a>
</p>

<p>
    <form asp-action="Index" method="get">
        <input type="text" name="keyword" value="@ViewBag.Keyword" placeholder="名称・管理番号・状態で検索" />
        <button type="submit">検索</button>
        <a asp-action="Index">クリア</a>
    </form>
</p>

<table border="2" cellpadding="10">
    <thead>
        <tr>
            <th>ID</th>
            <th>名称</th>
            <th>管理番号</th>
            <th>購入日</th>
            <th>状態</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.ManagementNumber</td>
                <td>@item.PurchaseDate.ToString("yyyy/MM/dd")</td>
                <td>@item.Status</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">編集</a>

                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit">削除</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
