@model EquipmentManagement.ViewModels.ItemIndexViewModel

@{
    ViewData["Title"] = "備品一覧";

    var categories = ViewBag.Categories as string[] ?? Array.Empty<string>();
    var locations = ViewBag.Locations as string[] ?? Array.Empty<string>();
    var statuses = ViewBag.Statuses as string[] ?? Array.Empty<string>();
    var sortOptions = ViewBag.SortOptions as Dictionary<string, string> ?? new Dictionary<string, string>();

    var activeConditions = new List<string>();

    if (!string.IsNullOrWhiteSpace(Model.Keyword))
    {
        activeConditions.Add($"キーワード：{Model.Keyword}");
    }

    if (!string.IsNullOrWhiteSpace(Model.Category))
    {
        activeConditions.Add($"カテゴリ：{Model.Category}");
    }

    if (!string.IsNullOrWhiteSpace(Model.Location))
    {
        activeConditions.Add($"保管場所：{Model.Location}");
    }

    if (!string.IsNullOrWhiteSpace(Model.Status))
    {
        activeConditions.Add($"状態：{Model.Status}");
    }

    if (sortOptions.TryGetValue(Model.SortOrder, out var selectedSortLabel))
    {
        activeConditions.Add($"並び順：{selectedSortLabel}");
    }

    var startPage = Math.Max(1, Model.CurrentPage - 2);
    var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

    if (endPage - startPage < 4)
    {
        if (startPage == 1)
        {
            endPage = Math.Min(Model.TotalPages, startPage + 4);
        }
        else if (endPage == Model.TotalPages)
        {
            startPage = Math.Max(1, endPage - 4);
        }
    }
}

<div class="page-header">
    <div>
        <h1 class="page-title">備品一覧</h1>
        <p class="page-description">
            登録済み備品の管理番号、所在、使用者、状態を確認できます。
        </p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="ExportCsv"
           asp-route-keyword="@Model.Keyword"
           asp-route-category="@Model.Category"
           asp-route-location="@Model.Location"
           asp-route-status="@Model.Status"
           asp-route-sortOrder="@Model.SortOrder"
           class="btn btn-outline-success">
            CSV出力
        </a>

        <a asp-action="Create" class="btn btn-primary">
            新規登録
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

<div class="summary-card">
    <div class="summary-item">
        <span class="summary-label">総件数</span>
        <span class="summary-value">@Model.TotalCount 件</span>
    </div>

    <div class="summary-item">
        <span class="summary-label">表示範囲</span>
        <span class="summary-value">
            @if (Model.TotalCount == 0)
            {
                <span>0 件</span>
            }
            else
            {
                <span>@Model.FirstItemNumber - @Model.LastItemNumber 件</span>
            }
        </span>
    </div>

    <div class="summary-item">
        <span class="summary-label">ページ</span>
        <span class="summary-value">
            @if (Model.TotalPages == 0)
            {
                <span>0 / 0</span>
            }
            else
            {
                <span>@Model.CurrentPage / @Model.TotalPages</span>
            }
        </span>
    </div>

    <div class="summary-item summary-item-wide">
        <span class="summary-label">検索条件</span>
        <span class="summary-value">
            @if (activeConditions.Any())
            {
                @string.Join(" / ", activeConditions)
            }
            else
            {
                <span>指定なし</span>
            }
        </span>
    </div>
</div>

<form asp-action="Index" method="get" class="search-panel search-panel-grid search-panel-grid-with-sort">
    <input type="hidden" name="page" value="1" />

    <div class="search-field search-field-keyword">
        <label for="keyword" class="form-label">キーワード検索</label>
        <input type="text"
               id="keyword"
               name="keyword"
               value="@Model.Keyword"
               class="form-control"
               maxlength="100"
               placeholder="名称・管理番号・使用者で検索" />
    </div>

    <div class="search-field">
        <label for="category" class="form-label">カテゴリ</label>
        <select id="category" name="category" class="form-select">
            <option value="">すべて</option>
            @foreach (var category in categories)
            {
                <option value="@category" selected="@(category == Model.Category)">@category</option>
            }
        </select>
    </div>

    <div class="search-field">
        <label for="location" class="form-label">保管場所</label>
        <select id="location" name="location" class="form-select">
            <option value="">すべて</option>
            @foreach (var location in locations)
            {
                <option value="@location" selected="@(location == Model.Location)">@location</option>
            }
        </select>
    </div>

    <div class="search-field">
        <label for="status" class="form-label">状態</label>
        <select id="status" name="status" class="form-select">
            <option value="">すべて</option>
            @foreach (var status in statuses)
            {
                <option value="@status" selected="@(status == Model.Status)">@status</option>
            }
        </select>
    </div>

    <div class="search-field">
        <label for="sortOrder" class="form-label">並び順</label>
        <select id="sortOrder" name="sortOrder" class="form-select">
            @foreach (var option in sortOptions)
            {
                <option value="@option.Key" selected="@(option.Key == Model.SortOrder)">@option.Value</option>
            }
        </select>
    </div>

    <div class="search-actions search-actions-grid">
        <button type="submit" class="btn btn-outline-primary">検索</button>
        <a asp-action="Index" class="btn btn-outline-secondary">クリア</a>
    </div>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(x => x.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

<div class="table-responsive item-list-wrapper">
    <table class="table table-hover align-middle item-list-table">
        <thead class="table-light">
            <tr>
                <th>管理番号</th>
                <th>名称</th>
                <th>カテゴリ</th>
                <th>購入日</th>
                <th class="text-end">購入金額</th>
                <th>保証期限</th>
                <th>保管場所</th>
                <th>使用者</th>
                <th>状態</th>
                <th>最終更新</th>
                <th class="text-nowrap">操作</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Any())
            {
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="text-nowrap item-management-number">@item.ManagementNumber</td>
                        <td class="item-name">@item.Name</td>
                        <td>@DisplayText(item.Category)</td>
                        <td class="text-nowrap">@item.PurchaseDate.ToString("yyyy/MM/dd")</td>
                        <td class="text-end text-nowrap">
                            @if (item.PurchasePrice.HasValue)
                            {
                                <span>¥@item.PurchasePrice.Value.ToString("N0")</span>
                            }
                            else
                            {
                                <span class="text-muted">未入力</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            @if (item.WarrantyUntil.HasValue)
                            {
                                <span>@item.WarrantyUntil.Value.ToString("yyyy/MM/dd")</span>
                            }
                            else
                            {
                                <span class="text-muted">未入力</span>
                            }
                        </td>
                        <td>@DisplayText(item.Location)</td>
                        <td>@DisplayText(item.AssignedUser)</td>
                        <td>
                            <span class="status-badge @GetStatusClass(item.Status)">
                                @item.Status
                            </span>
                        </td>
                        <td class="text-nowrap">@item.UpdatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                        <td class="text-nowrap item-action-cell">
                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-secondary">
                                詳細
                            </a>
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">
                                編集
                            </a>

                            @if (item.Status != "廃棄済み")
                            {
                                <form asp-action="MarkAsDisposed"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('この備品の状態を廃棄済みに変更します。よろしいですか？');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-warning">
                                        廃棄済みにする
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Delete"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('この廃棄済み備品を台帳から非表示にします。よろしいですか？');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        台帳から非表示
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="11" class="empty-message">
                        条件に一致する備品はありません。
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <div class="pagination-area">
        <div class="pagination-info">
            全 @Model.TotalCount 件中 @Model.FirstItemNumber - @Model.LastItemNumber 件を表示
        </div>

        <nav aria-label="備品一覧ページ切り替え">
            <ul class="pagination mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-keyword="@Model.Keyword"
                       asp-route-category="@Model.Category"
                       asp-route-location="@Model.Location"
                       asp-route-status="@Model.Status"
                       asp-route-sortOrder="@Model.SortOrder"
                       asp-route-page="@(Model.CurrentPage - 1)">
                        前へ
                    </a>
                </li>

                @if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-keyword="@Model.Keyword"
                           asp-route-category="@Model.Category"
                           asp-route-location="@Model.Location"
                           asp-route-status="@Model.Status"
                           asp-route-sortOrder="@Model.SortOrder"
                           asp-route-page="1">1</a>
                    </li>

                    @if (startPage > 2)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                }

                @for (var i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-keyword="@Model.Keyword"
                           asp-route-category="@Model.Category"
                           asp-route-location="@Model.Location"
                           asp-route-status="@Model.Status"
                           asp-route-sortOrder="@Model.SortOrder"
                           asp-route-page="@i">@i</a>
                    </li>
                }

                @if (endPage < Model.TotalPages)
                {
                    @if (endPage < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }

                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-keyword="@Model.Keyword"
                           asp-route-category="@Model.Category"
                           asp-route-location="@Model.Location"
                           asp-route-status="@Model.Status"
                           asp-route-sortOrder="@Model.SortOrder"
                           asp-route-page="@Model.TotalPages">@Model.TotalPages</a>
                    </li>
                }

                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-keyword="@Model.Keyword"
                       asp-route-category="@Model.Category"
                       asp-route-location="@Model.Location"
                       asp-route-status="@Model.Status"
                       asp-route-sortOrder="@Model.SortOrder"
                       asp-route-page="@(Model.CurrentPage + 1)">
                        次へ
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}

@functions {
    private static string DisplayText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "未入力" : value;
    }

    private static string GetStatusClass(string status)
    {
        return status switch
        {
            "使用中" => "status-in-use",
            "保管中" => "status-storage",
            "修理中" => "status-repair",
            "廃棄済み" => "status-disposed",
            _ => "status-default"
        };
    }
}
